TRANSCRIBE_PROVIDER=faster_whisper
WHISPER_MODEL=small
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=default

# Bengali model — must be a LOCAL CTranslate2-converted directory, NOT a HuggingFace repo ID.
# Convert once with:
#   ct2-transformers-converter --model anuragshas/whisper-small-bn \
#       --output_dir models/whisper-small-bn-ct2 --quantization int8
WHISPER_MODEL_BN=models/whisper-small-bn-ct2

# Language-ID router (SpeechBrain ECAPA-TDNN)
LID_MODEL=speechbrain/lang-id-voxlingua107-ecapa
LID_BN_THRESHOLD=0.7
LID_SAVEDIR=pretrained_models

MAX_UPLOAD_MB=25
