# ─────────────────────────────────────────────────────────────────────────────
# Celloscope AI Service — Environment Configuration
#
# Copy this file to .env and fill in real values.
# NEVER commit .env — it is listed in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# ── Document Extraction Provider ──────────────────────────────────────────────
# Provider for Endpoint 2 (document extraction).
# Accepted values: mock, mistral_ocr
#
# By default, use "mock" for clean Docker environment / CI.
DOCUMENT_EXTRACTION_PROVIDER=mock

# Mistral API key (Required when provider is mistral_ocr)
MISTRAL_API_KEY=

# ── Transcription provider ────────────────────────────────────────────────────
# "faster_whisper" uses a real local GPU/CPU Whisper model.
# "mock"          loads fixture JSON files — no GPU needed, great for CI/dev.
TRANSCRIBE_PROVIDER=faster_whisper

# ── Local Whisper model (English, primary) ────────────────────────────────────
# Standard faster-whisper checkpoint: tiny | base | small | medium | large-v3
WHISPER_MODEL=small

# ── Bengali fine-tuned model (local path) ────────────────────────────────────
# Path to a CTranslate2-converted Bengali-tuned checkpoint.
# Leave empty to route all Bengali audio through the primary model instead.
# Example: pretrained_models/faster-whisper-bangla-small-int8
WHISPER_MODEL_BN=pretrained_models/faster-whisper-bangla-small-int8

# ── Hardware ──────────────────────────────────────────────────────────────────
# "cuda" for NVIDIA GPU (recommended); "cpu" for CPU-only inference.
WHISPER_DEVICE=cuda
# Compute type: "default" (auto), "int8", "float16", "float32"
WHISPER_COMPUTE_TYPE=default

# ── Upload limits ─────────────────────────────────────────────────────────────
# Maximum accepted audio file size in megabytes.
MAX_UPLOAD_MB=25

# ── No-speech detection tuning ────────────────────────────────────────────────
# Combined threshold: audio is marked as silence when BOTH conditions are true:
#   no_speech_prob >= NO_SPEECH_PROB_THRESHOLD  AND  avg_logprob <= AVG_LOGPROB_THRESHOLD
NO_SPEECH_PROB_THRESHOLD=0.6
AVG_LOGPROB_THRESHOLD=-1.0

# ── Groq language detection — Stage 1 of the two-stage pipeline ───────────────
# Your Groq Cloud API key. Get one free at https://console.groq.com
# ⚠ NEVER commit this value. Keep it only in .env (gitignored).
GROQ_API_KEY=

# Groq Whisper model used for language detection (detection-only, no transcript).
# whisper-large-v3-turbo is fast and accurate for language ID.
GROQ_MODEL=whisper-large-v3-turbo

# Set to "false" to disable remote detection and always use local auto-detect.
# Useful for air-gapped environments or when conserving API quota.
ENABLE_REMOTE_LANGUAGE_DETECTION=true

# Hard timeout in seconds for the Groq HTTP call.
# If Groq doesn't respond within this window, the local fallback takes over.
LANGUAGE_DETECTION_TIMEOUT_SECONDS=8.0

# Duration (seconds) of audio trimmed and sent to Groq for detection.
# Only this short sample leaves the machine — the full audio is never uploaded.
LANGUAGE_DETECTION_SAMPLE_SECONDS=12.0

# ── Logging ───────────────────────────────────────────────────────────────────
# Python logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
